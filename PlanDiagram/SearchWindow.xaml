<Window x:Class="PlanDiagram.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор фильтров" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <TextBox x:Name="SearchTextBox" 
                 Grid.Row="0"
                 Margin="0,0,0,10"
                 Padding="8"
                 FontSize="14"
                 TextChanged="SearchTextBox_TextChanged">
            <TextBox.Tag>
                <TextBlock Text="🔍 Поиск..." 
                           VerticalAlignment="Center" 
                           Margin="8,0"
                           IsHitTestVisible="False"/>
            </TextBox.Tag>
        </TextBox>

        <!-- Табы -->
        <TabControl Grid.Row="1" Margin="0,0,0,10">
            <TabItem Header="Заказы производства">
                <ListBox x:Name="ProductionOrdersList" 
                         SelectionMode="Extended"
                         DisplayMemberPath="DocNumber"
                         Margin="5"/>
            </TabItem>

            <TabItem Header="Заказы клиента">
                <ListBox x:Name="ClientOrdersList" 
                         SelectionMode="Extended"
                         DisplayMemberPath="DocNumber"
                         Margin="5"/>
            </TabItem>

            <TabItem Header="Изделия">
                <ListBox x:Name="ItemsList" 
                         SelectionMode="Single"
                         DisplayMemberPath="ItemFullName"
                         Margin="5"/>
            </TabItem>
        </TabControl>

        <!-- Выбранные параметры -->
        <Border Grid.Row="2" 
                Background="#FFF9F9F9" 
                BorderBrush="#FFD0D0D0" 
                BorderThickness="1" 
                CornerRadius="5"
                Padding="8"
                Margin="0,0,0,10">
            <TextBlock x:Name="SelectedText" 
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#FF666666"/>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сбросить" 
                    Click="ClearButton_Click" 
                    Width="80" 
                    Margin="0,0,10,0"
                    Padding="6,4"/>
            <Button Content="Применить" 
                    Click="ApplyButton_Click" 
                    Width="80" 
                    Margin="0,0,10,0"
                    Padding="6,4"
                    IsDefault="True"/>
            <Button Content="Отмена" 
                    Click="CancelButton_Click" 
                    Width="80" 
                    Padding="6,4"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>