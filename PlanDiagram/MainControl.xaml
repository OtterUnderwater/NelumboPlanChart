<UserControl x:Class="PlanDiagram.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с фильтрами -->
        <Border Grid.Row="0" Margin="10" Padding="10" Background="#F0F0F0" CornerRadius="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Начальная дата:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker x:Name="StartDatePicker" SelectedDateFormat="Short"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Конечная дата:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker x:Name="EndDatePicker" SelectedDateFormat="Short"/>
                    </StackPanel>
                    <Button x:Name="BuildButton" Width="150" Height="30" Background="DodgerBlue" 
                            Click="BuildButton_Click" Content="Сформировать отчет" 
                            Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Основная область: список и диаграмма -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: заголовок "Процесс" + список -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок левой колонки -->
                <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                    <TextBlock Text="Процесс" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Bold"/>
                </Border>

                <!-- Список процессов (синхронизация прокрутки) -->
                <ScrollViewer Grid.Row="1" x:Name="LeftScrollViewer" 
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              ScrollChanged="LeftScrollViewer_ScrollChanged">
                    <ItemsControl x:Name="TasksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Height="40" 
                                        Background="White" Padding="5,0">
                                    <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center"
                                               ToolTip="{Binding TooltipText}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Правая колонка: заголовок с датами + диаграмма -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок с датами (горизонтальная прокрутка) -->

                <!-- Заголовок правой панели с датами -->
                <ScrollViewer Grid.Row="0" x:Name="DateHeaderScrollViewer"
                          HorizontalScrollBarVisibility="Visible" 
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Left"
                          ScrollChanged="DateHeaderScrollViewer_ScrollChanged">
                    <Border Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="1,0,0,1">
                        <Canvas x:Name="DateHeaderCanvas" Height="50" Background="#E8E8E8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Border>
                </ScrollViewer>

                <!-- Область с диаграммой Ганта -->
                <ScrollViewer Grid.Row="1" x:Name="GanttScrollViewer"   
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"                        
                              ScrollChanged="GanttScrollViewer_ScrollChanged">
                    <ItemsControl x:Name="GanttItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TaskBorder" Height="40" BorderBrush="#E0E0E0" 
                        BorderThickness="0,0,0,1" Background="#FEFEFE"
                        MouseLeftButtonDown="TaskItem_Click"
                        Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}, Path=ActualWidth}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEFEFE"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E5F0FF"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Canvas>
                                        <!-- Прямоугольник задачи - теперь DataContext установлен правильно -->
                                        <Border Background="{Binding GanttItem.Color}" 
                                Width="{Binding GanttItem.Width}" 
                                Height="34" 
                                CornerRadius="3"
                                Cursor="Hand"
                                Tag="{Binding TaskData}"
                                MouseLeftButtonDown="GanttItem_Click"
                                Canvas.Left="{Binding GanttItem.Left}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding GanttItem.Color}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{Binding GanttItem.HoverColor}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding GanttItem.DisplayText}" 
                                       FontSize="11" 
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="4,0"/>
                                        </Border>
                                    </Canvas>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>