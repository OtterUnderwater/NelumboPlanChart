<UserControl x:Class="PlanDiagram.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:PlanDiagram.Models"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1100">
    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с фильтрами -->
        <Border Grid.Row="0" Margin="10" Padding="10" Background="#F0F0F0" CornerRadius="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Начальная дата:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker x:Name="StartDatePicker" SelectedDateFormat="Short"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Конечная дата:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker x:Name="EndDatePicker" SelectedDateFormat="Short"/>
                    </StackPanel>
                    <Button x:Name="BuildButton" Width="150" Height="30" Background="DodgerBlue" 
                            Click="BuildButton_Click" Content="Сформировать отчет" 
                            Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Основная область: список и диаграмма -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: заголовок + список -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок левой колонки (привязан к свойству) -->
                <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                    <TextBlock Text="{Binding LeftColumnTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Bold"/>
                </Border>

                <!-- Список процессов или рабочих мест (привязан к LeftColumnItems) -->
                <ScrollViewer Grid.Row="1" x:Name="LeftScrollViewer" 
                     HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      ScrollChanged="LeftScrollViewer_ScrollChanged">
                    <ItemsControl x:Name="TasksList" ItemsSource="{Binding LeftColumnItems}">
                        <ItemsControl.Resources>
                            <!-- Шаблон для объектов ProcessData -->
                            <DataTemplate DataType="{x:Type models:ProcessData}">
                                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Height="40" 
                    Background="White" Padding="5,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessName}"/>
                                        <TextBlock Text=" - "/>
                                        <TextBlock Text="{Binding OpName}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- Шаблон для строк (рабочих мест) -->
                            <DataTemplate DataType="{x:Type system:String}">
                                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Height="60" 
                    Background="White" Padding="5,0">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Правая колонка: заголовок с датами + диаграмма -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок с датами -->
                <ScrollViewer Grid.Row="0" x:Name="DateHeaderScrollViewer"
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Visible"
                              ScrollChanged="DateHeaderScrollViewer_ScrollChanged">
                    <Border Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="1,0,0,1">
                        <Canvas x:Name="DateHeaderCanvas" Height="50" Background="#E8E8E8" HorizontalAlignment="Left"/>
                    </Border>
                </ScrollViewer>

                <!-- Область с диаграммой Ганта -->
                <ScrollViewer Grid.Row="1" x:Name="GanttScrollViewer"   
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"                        
                              ScrollChanged="GanttScrollViewer_ScrollChanged">
                    <Canvas x:Name="GanttCanvas" 
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#FEFEFE" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>